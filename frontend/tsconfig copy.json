{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "moduleResolution": "node",
    "types": ["vite/client", "node"],
    "typeRoots": ["./frontend/node_modules/@types", "./node_modules/@types"],
    "paths": {
      "@/*": ["frontend/src/*"]
    }
  },
  "include": [
    "frontend/src/**/*",
    "frontend/vite.config.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx"
, "src/lib/config.server.ts", "src/lib/error-capture.ts", "frontend/src/hooks", "src/lib/error-page.ts", "src/lib/error-reporting.ts", "src/lib/sudoku-ai.functions.ts", "src/lib/sudoku.ts", "src/lib/tesseract-ocr.ts", "src/lib/utils.ts"  ]
}
