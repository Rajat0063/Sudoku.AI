# Example Supabase env vars for local development
# Copy this to a file named .env and fill in real values.
# For Vite, client keys must be prefixed with VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side service role key (only for server use — keep secret)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
